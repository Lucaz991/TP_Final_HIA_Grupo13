# Imagen de desarrollo para Frontend (Angular Dev Server con Hot Reload)
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .

EXPOSE 4200

# --host 0.0.0.0 permite acceder desde fuera del contenedor
# --poll 2000 asegura la detección de cambios en volúmenes de Windows
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000"]